<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Owns the ephemeral PostgreSQL container these tests run against. Test projects only. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- ConfigurationBuilder/AddInMemoryCollection, to hand AddPersistence its connection string. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!--
      Same reason as the API integration tests: Npgsql only floors Relational at 10.0.4, and the
      Microsoft.EntityFrameworkCore.Design reference that raises it to 10.0.11 in SmartProperty.Persistence
      carries PrivateAssets="all" and does not flow here. Referencing it explicitly keeps this project on the
      same assembly its project references were compiled against, and keeps the build free of MSB3277.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\SmartProperty.Application\SmartProperty.Application.csproj" />
    <ProjectReference Include="..\..\src\Core\SmartProperty.Common\SmartProperty.Common.csproj" />
    <ProjectReference Include="..\..\src\Core\SmartProperty.Domain\SmartProperty.Domain.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\SmartProperty.Persistence\SmartProperty.Persistence.csproj" />
  </ItemGroup>
</Project>
