<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!--
      Not used by any test directly. It is referenced so this project resolves the same
      Microsoft.EntityFrameworkCore.Relational assembly the referenced production projects were compiled
      against: Npgsql only floors Relational at 10.0.4, and the Design package that raises it to 10.0.11
      elsewhere is PrivateAssets="all" and does not flow here. Without it the build reports MSB3277.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\SmartProperty.Application\SmartProperty.Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\SmartProperty.Persistence\SmartProperty.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Presentation\SmartProperty.Api\SmartProperty.Api.csproj" />
  </ItemGroup>
</Project>
