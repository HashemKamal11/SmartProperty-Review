# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
#
#   cp .env.example .env
#
# Both variables are required by docker-compose.yml and Compose fails fast without them.

# PostgreSQL password for the smart_property user.
# Avoid ';', '=' and quotes: the value is also interpolated into the Npgsql connection string.
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key. Must be at least 32 bytes (JwtOptions.MinimumSigningKeyBytes).
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME

# Optional token lifetimes as TimeSpan (d.hh:mm:ss). Defaults: 00:15:00 and 7.00:00:00.
# For local manual testing only, long values avoid expiry, e.g. 365.00:00:00.
# JWT_ACCESS_TOKEN_LIFETIME=00:15:00
# JWT_REFRESH_TOKEN_LIFETIME=7.00:00:00

# Initial deployment workspace. Enable this for the first migration run and keep this stable ID for registration.
# When enabled, both ID and Name are required; the migrator exits non-zero on invalid or conflicting values.
INITIAL_WORKSPACE_ENABLED=false
INITIAL_WORKSPACE_ID=CHANGE_ME_TO_A_NON_EMPTY_GUID
INITIAL_WORKSPACE_NAME=Initial Workspace

# One-time elevation of an existing registered user. Keep disabled on the first start. After registration, enable
# it with that user's email for one API restart, verify the grant, then disable it again.
BOOTSTRAP_ENABLED=false
#BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com

# TEMPORARY. true marks a registered phone number as verified at once, with no SMS and no proof, for a deployment
# that has no SMS provider yet. Email is still verified by code. Set false (the default) once SMS delivery works.
AUTO_VERIFY_PHONE=false

# Optional. Email (verification and password reset codes) through SMTP. With SMTP_HOST empty the API sends nothing.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USERNAME=your address, SMTP_PASSWORD=an app password written without spaces.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_ENABLE_SSL=true
#SMTP_USERNAME=you@example.com
#SMTP_PASSWORD=CHANGE_ME
#SMTP_FROM_ADDRESS=you@example.com
#SMTP_FROM_NAME=SmartProperty

# Optional. Host port published for the API. Defaults to 5000.
#API_PORT=5000

# Optional frontend origins allowed by the API's CORS policy. Blank means fail closed: browser cross-origin
# requests receive no Access-Control-Allow-Origin header. Values must be exact HTTP(S) origins without a path.
#CORS_ALLOWED_ORIGIN_0=https://app.example.com
#CORS_ALLOWED_ORIGIN_1=https://admin.example.com

# Optional, local development only, used by docker-compose.local.yml.
# Host port for PostgreSQL, bound to 127.0.0.1. Defaults to 5432.
#POSTGRES_PORT=5432

# Optional. Shared secret the external AI system sends in the X-Api-Key header to POST /api/property-matches.
# Blank means the endpoint refuses every request. Generate one with: openssl rand -base64 32
#AI_INTEGRATION_API_KEY=CHANGE_ME

# AI search service (https://ai-search.neurix.uk/docs). Every property is sent to it when it is created or
# changed, and user searches are answered by it. Off unless AI_SEARCH_ENABLED=true, so a local run or a test never
# writes into the shared AI service by accident. See docs/ai-search-integration.md.
AI_SEARCH_ENABLED=false
# Only change this to point at a different AI environment.
#AI_SEARCH_BASE_URL=https://ai-search.neurix.uk
# Secret sent as the x-api-key header when adding or removing properties. Searching needs no key.
#AI_SEARCH_API_KEY=CHANGE_ME
# Seconds to wait for the AI service before a call counts as failed (1-300). Defaults to 30.
#AI_SEARCH_TIMEOUT_SECONDS=30


# Uploaded property photos.
# Folder on the host where the photos are kept (relative to docker-compose.yml, or absolute). It is mounted into the API container.
IMAGE_STORAGE_HOST_PATH=./Storage
# Directory inside the API container where it is mounted. Only change it together with the mount in docker-compose.yml.
IMAGE_STORAGE_PATH=/data/images

# Optional. Address of the front-end site that opens a shared property (no trailing path), e.g. https://app.example.com.
# When empty, share links use the address the API was called on.
SHARE_PUBLIC_BASE_URL=
# Optional. Front-end route for one property; {id} is replaced by the property id.
SHARE_PROPERTY_PATH=/properties/{id}

# Automatic relisting: a nightly pass that submits closed listings set to relistMode=Automatic for admin review again,
# once the accepted request that closed them ended without a deal (signature deadline passed, or rental returned).
# true or false. If several API containers run, set it to true on one only.
AUTOMATIC_RELIST_ENABLED=true
# How often it runs: a number with m (minutes), h (hours) or d (days), e.g. 5m, 1h, 1d (1m to 7d), counted from when the API starts.
# Leave it empty (AUTOMATIC_RELIST_EVERY=) to use the fixed daily times in AUTOMATIC_RELIST_RUN_AT instead.
AUTOMATIC_RELIST_EVERY=15m
# Used only when AUTOMATIC_RELIST_EVERY is empty: local time(s) of day, HH:mm (24-hour), comma-separated for several, e.g. 01:00,13:00.
AUTOMATIC_RELIST_RUN_AT=01:00
# IANA time zone RUN_AT is read in, e.g. Africa/Cairo, Asia/Dubai, Asia/Riyadh.
AUTOMATIC_RELIST_TIME_ZONE=Africa/Cairo
# The most listings one pass relists (1-10000). The rest wait for the next night.
AUTOMATIC_RELIST_BATCH_SIZE=500
# true or false. Also run once, 1 minute after the API starts, to catch up on what became due while it was down or redeploying.
AUTOMATIC_RELIST_RUN_ON_STARTUP=true
