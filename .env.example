# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
#
#   cp .env.example .env
#
# Both variables are required by docker-compose.yml and Compose fails fast without them.

# PostgreSQL password for the smart_property user.
# Avoid ';', '=' and quotes: the value is also interpolated into the Npgsql connection string.
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key. Must be at least 32 bytes (JwtOptions.MinimumSigningKeyBytes).
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Optional. Host port published for the API. Defaults to 5000.
#API_PORT=5000

# Optional, local development only, used by docker-compose.local.yml.
# Host port for PostgreSQL, bound to 127.0.0.1. Defaults to 5432.
#POSTGRES_PORT=5432
