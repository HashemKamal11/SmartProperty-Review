# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
#
#   cp .env.example .env
#
# Both variables are required by docker-compose.yml and Compose fails fast without them.

# PostgreSQL password for the smart_property user.
# Avoid ';', '=' and quotes: the value is also interpolated into the Npgsql connection string.
POSTGRES_PASSWORD=CHANGE_ME

# JWT signing key. Must be at least 32 bytes (JwtOptions.MinimumSigningKeyBytes).
# Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=CHANGE_ME

# Initial deployment workspace. Enable this for the first migration run and keep this stable ID for registration.
# When enabled, both ID and Name are required; the migrator exits non-zero on invalid or conflicting values.
INITIAL_WORKSPACE_ENABLED=false
INITIAL_WORKSPACE_ID=CHANGE_ME_TO_A_NON_EMPTY_GUID
INITIAL_WORKSPACE_NAME=Initial Workspace

# One-time elevation of an existing registered user. Keep disabled on the first start. After registration, enable
# it with that user's email for one API restart, verify the grant, then disable it again.
BOOTSTRAP_ENABLED=false
#BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com

# Optional. Host port published for the API. Defaults to 5000.
#API_PORT=5000

# Optional frontend origins allowed by the API's CORS policy. Blank means fail closed: browser cross-origin
# requests receive no Access-Control-Allow-Origin header. Values must be exact HTTP(S) origins without a path.
#CORS_ALLOWED_ORIGIN_0=https://app.example.com
#CORS_ALLOWED_ORIGIN_1=https://admin.example.com

# Optional, local development only, used by docker-compose.local.yml.
# Host port for PostgreSQL, bound to 127.0.0.1. Defaults to 5432.
#POSTGRES_PORT=5432
