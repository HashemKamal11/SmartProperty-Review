{
  "ConnectionStrings": {
    "Database": ""
  },
  "Bootstrap": {
    "Enabled": false,
    "PlatformAdminEmail": ""
  },
  "Share": {
    "PublicBaseUrl": "",
    "PropertyPath": "/properties/{id}"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitLimit": 20,
    "SearchPermitLimit": 30,
    "WindowSeconds": 60
  },
  "Jwt": {
    "Issuer": "SmartProperty",
    "Audience": "SmartProperty.Api",
    "SigningKey": "",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "ImageStorage": {
    "RootPath": "App_Data/images"
  },
  "DocumentStorage": {
    "RootPath": "App_Data/documents"
  },
  "MalwareScanning": {
    "ClamAvHost": "",
    "ClamAvPort": 3310,
    "TimeoutSeconds": 120,
    "WorkerEnabled": true,
    "PollIntervalSeconds": 10,
    "MaxAttempts": 5,
    "RetryBaseDelaySeconds": 30,
    "RetryMaxDelayMinutes": 30,
    "BatchSize": 20
  },
  "StaffRoles": {
    "ProvisionOnStartup": true
  },
  "AiSearch": {
    "Enabled": false,
    "BaseUrl": "https://ai-search.neurix.uk",
    "ApiKey": "",
    "TimeoutSeconds": 30
  },
  "ContactVerification": {
    "AutoVerifyPhone": false
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "CHANGEME",
    "Password": "CHANGEME",
    "FromAddress": "CHANGEME",
    "FromName": "SmartProperty"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
