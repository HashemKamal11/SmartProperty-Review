<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the executable on the same EF relational assembly as Persistence; Npgsql otherwise floors at 10.0.4. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\SmartProperty.Application\SmartProperty.Application.csproj" />
    <ProjectReference Include="..\..\Core\SmartProperty.Domain\SmartProperty.Domain.csproj" />
    <ProjectReference Include="..\SmartProperty.Persistence\SmartProperty.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
